{
  "name": "gestaerp",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bump:patch": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const v=p.version.split('.');v[2]++;p.version=v.join('.');fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');const t=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8'));t.version=v.join('.');fs.writeFileSync('src-tauri/tauri.conf.json',JSON.stringify(t,null,2)+'\\n');const c=fs.readFileSync('src-tauri/Cargo.toml','utf8').replace(/version = \\\"[^\\\"]+\\\"/,'version = \\\"'+v.join('.')+'\\\"');fs.writeFileSync('src-tauri/Cargo.toml',c);console.log('Version bumped to '+v.join('.'))\"",
    "bump:minor": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const v=p.version.split('.');v[1]++;v[2]=0;p.version=v.join('.');fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');const t=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8'));t.version=v.join('.');fs.writeFileSync('src-tauri/tauri.conf.json',JSON.stringify(t,null,2)+'\\n');const c=fs.readFileSync('src-tauri/Cargo.toml','utf8').replace(/version = \\\"[^\\\"]+\\\"/,'version = \\\"'+v.join('.')+'\\\"');fs.writeFileSync('src-tauri/Cargo.toml',c);console.log('Version bumped to '+v.join('.'))\"",
    "bump:major": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const v=p.version.split('.');v[0]++;v[1]=0;v[2]=0;p.version=v.join('.');fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');const t=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8'));t.version=v.join('.');fs.writeFileSync('src-tauri/tauri.conf.json',JSON.stringify(t,null,2)+'\\n');const c=fs.readFileSync('src-tauri/Cargo.toml','utf8').replace(/version = \\\"[^\\\"]+\\\"/,'version = \\\"'+v.join('.')+'\\\"');fs.writeFileSync('src-tauri/Cargo.toml',c);console.log('Version bumped to '+v.join('.'))\"",
    "release": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const v=p.version;console.log('Creating release v'+v+'...');console.log('Run: git add -A && git commit -m release:v'+v+' && git tag v'+v+' && git push --tags')\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.76.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
