# ============================================================
# GestaERP — Variables de Entorno
# ============================================================
# Copia este archivo a .env y configura los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ============================================================

# ---------- Licencias / HMAC ----------
# Clave secreta para firmar y validar licencias de activación.
# Debe ser una cadena aleatoria de al menos 32 caracteres.
# En producción, cambiar el valor por defecto.
GESTAERP_SECRET_KEY=GestaERP_2026_SecureKey_Colombia

# ---------- Base de Datos (SQLite) ----------
# Pepper para derivar la clave de base de datos por máquina.
# No es secreto pero añade entropía al binding de máquina.
GESTAERP_DB_PEPPER=GestaERP_Colombia_2026_DB_PEPPER

# ---------- Logging ----------
# Nivel de log: trace, debug, info, warn, error
GESTAERP_LOG_LEVEL=info

# ---------- Entorno ----------
# development | production
GESTAERP_ENV=development